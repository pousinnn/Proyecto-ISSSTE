# Copia este archivo como .env y llena los valores.
# .env NUNCA se sube a GitHub (está en .gitignore).

# Puerto donde escucha el API
PORT=3000

# Conexión a MongoDB y nombre de la base de datos
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=issste

# Clave secreta para firmar los tokens JWT.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=clave-secreta-larga-y-segura

# Cuánto dura una sesión antes de pedir login otra vez
JWT_EXPIRES_IN=1h

# Origen del frontend al que se le permite llamar al API (CORS)
FRONTEND_ORIGIN=http://localhost:5173
